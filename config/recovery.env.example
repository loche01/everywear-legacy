# Copy these names into an external environment or Tomcat setenv.sh.
# Do not commit real credentials.
EVERYWEAR_DB_DRIVER=com.mysql.cj.jdbc.Driver
EVERYWEAR_DB_URL=jdbc:mysql://127.0.0.1:3307/everywear_recovery
EVERYWEAR_DB_USER=replace_me
EVERYWEAR_DB_PASSWORD=replace_me

EVERYWEAR_SMTP_USER=replace_me
EVERYWEAR_SMTP_PASSWORD=replace_me

EVERYWEAR_SMS_API_KEY=replace_me
EVERYWEAR_SMS_API_SECRET=replace_me
EVERYWEAR_SMS_SENDER=replace_me

GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me
EVERYWEAR_GOOGLE_REDIRECT_URI=
KAKAO_CLIENT_ID=replace_me
EVERYWEAR_KAKAO_REDIRECT_URI=
EVERYWEAR_NAVER_CLIENT_ID=
EVERYWEAR_NAVER_CLIENT_SECRET=
EVERYWEAR_NAVER_REDIRECT_URI=
